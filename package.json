{
  "name": "renvodesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/copy-excalidraw-fonts.mjs && vite --host 127.0.0.1",
    "build": "node scripts/copy-excalidraw-fonts.mjs && tsc --noEmit && vite build && node scripts/prerender-landing.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:cad": "vite --config vite.cad-prototype.config.ts --host 127.0.0.1",
    "build:cad": "tsc --noEmit && vite build --config vite.cad-prototype.config.ts",
    "test:cad": "playwright test --config playwright.cad.config.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mlightcad/cad-simple-viewer": "1.7.1",
    "@mlightcad/data-model": "1.14.8",
    "@mlightcad/mtext-renderer": "0.12.12",
    "@mlightcad/three-renderer": "1.7.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/react": "10.75.2",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lodash-es": "4.17.21",
    "lucide-react": "^1.47.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "three": "0.172.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
