# Install as /etc/renvodesk/api.env on the VPS: owner root, group renvodesk-api,
# mode 0640. Never commit the real file or copy it into a release directory.
API_SUPABASE_URL=https://oripsywzngftarbprlgk.supabase.co
# The same public publishable key the browser build uses.
API_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
API_PORT=3001
# Secret. Type it on the server only; never paste it into chat, tickets or git.
# Without it the API runs and AI routes report "ai_unavailable".
OPENAI_API_KEY=
# Global API is the default. Europe requires eligible OpenAI data residency.
OPENAI_API_ORIGIN=https://api.openai.com
AI_MAX_CONCURRENT_JOBS=4
API_LOG_LEVEL=info
