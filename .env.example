# Browser-safe configuration only. Never put a service-role or secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Build-time public origin for canonical URLs, hreflang and sitemap.
# Set only for the verified production hostname, e.g. https://your-verified-domain.com
# Leave unset for preview builds (noindex; no sitemap). Not a VITE_* browser secret.
# SITE_URL=

# Optional telemetry: production build AND matching origin AND user consent required.
VITE_TELEMETRY_ENABLED=false
VITE_PUBLIC_ORIGIN=https://renvodesk.com
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=
VITE_RELEASE=
VITE_PRIVACY_OPERATOR=
VITE_PRIVACY_EMAIL=
# Configured public production values: deploy/production.env.example
