# Copy to apps/api/.env.local for local development. Never commit that file.
# Use the same Supabase project as the browser app, with its publishable key.
API_SUPABASE_URL=https://your-project.supabase.co
API_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
API_PORT=3001
# Optional. Required to run AI analysis; keep this secret on the API server.
# OPENAI_API_KEY=your_server_side_key
# Global API is the default. Europe requires eligible OpenAI data residency settings.
# OPENAI_API_ORIGIN=https://eu.api.openai.com
